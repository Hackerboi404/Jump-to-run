# ShadowPanel — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file to git.

# ──────────────────────────────────────────────
# Frontend (Vite) — exposed via VITE_ prefix
# ──────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# ──────────────────────────────────────────────
# Backend (Node.js) — server-only secrets
# ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Telegram Bot credentials (from @BotFather)
BOT_TOKEN=8621419719:AAEsz6OltN_XczyZ0HVa6xYsajOKeYsF4Ec

# Telegram API credentials (from https://my.telegram.org)
# Only needed if you also use MTProto for userbot features
API_ID=29765104
API_HASH=1c0348c74607923c87b7cab20bc77af0

# MongoDB
MONGO_URI=mongodb://localhost:27017/shadowpanel

# JWT
JWT_SECRET=change_this_to_a_strong_random_string
JWT_EXPIRES_IN=7d

# Optional: session encryption
SESSION_SECRET=another_random_string_here
